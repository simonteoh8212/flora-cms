# ========================================================
# Flora CMS - Environment Configuration
# ========================================================

# 1. Database Connection (Supabase / Vercel Postgres)
# DATABASE_URL uses connection pooling (port 6543, pgbouncer=true) for serverless queries
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# DIRECT_URL uses direct session connection (port 5432) for schema push and migrations
DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# 2. Cloudinary Credentials (For Mobile Photo Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
