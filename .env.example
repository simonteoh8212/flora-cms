# ========================================================
# Flora CMS - Environment Configuration
# ========================================================

# 1. Database Connection (Vercel Postgres / Neon / PostgreSQL)
# When deploying to Vercel and attaching a Vercel Postgres database,
# Vercel automatically creates POSTGRES_PRISMA_URL and DATABASE_URL.
DATABASE_URL="postgres://default:your_password@ep-cool-snowflake-12345.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Optional: If using Vercel Postgres connection pooling with Prisma:
# POSTGRES_PRISMA_URL="postgres://default:your_password@ep-cool-snowflake-12345-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"

# 2. Cloudinary Credentials (For Mobile Photo Uploads)
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
